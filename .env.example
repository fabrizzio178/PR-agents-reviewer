GITHUB_TOKEN=

# --- LLM: pick one provider ---

# Option A: Gemini (default)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Option B: any OpenAI-compatible API (OpenCode Zen, OpenRouter, DeepSeek...)
# LLM_PROVIDER=openai-compatible
# LLM_API_KEY=
# LLM_BASE_URL=https://opencode.ai/zen/v1
# LLM_MODEL=

# Optional (defaults shown) — see docs/SPEC.md §11
# REVIEW_MAX_FILE_CHARS=20000
# REVIEW_MAX_TOTAL_CHARS=120000
# REVIEW_GATE_SEVERITY=high
# REVIEW_CHECKPOINT_PATH=agent_langgraph.sqlite

# Optional LangSmith tracing
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
